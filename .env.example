# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env - it is gitignored.
# Every variable below is optional except DATABASE_URL; the defaults shown are
# what the application uses when the variable is absent.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (PostgreSQL) ---
# Without this the API still serves all pricing and risk endpoints; only the
# persistence routes return 503.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# TLS certificate verification. Leave unset (defaults to strict) unless your
# provider uses a private CA, in which case supply the CA below instead of
# disabling verification.
# DATABASE_SSL_STRICT=true
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000

# --- Market data feed ---
MARKET_DATA_CACHE_TTL_MS=900000
MARKET_DATA_TIMEOUT_MS=8000
MARKET_DATA_MAX_RETRIES=2

# --- Portfolio analytics ---
PORTFOLIO_MAX_ASSETS=12
PORTFOLIO_TRADING_DAYS=252
PORTFOLIO_RISK_FREE_RATE=0.04

# --- Options pricing ---
OPTIONS_MAX_STEPS=5000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# --- CORS ---
# Comma-separated allow-list. Leave empty to permit any origin (public demo).
CORS_ALLOWED_ORIGINS=https://portfolio-analyzer-three.vercel.app
