{
  "name": "quant-terminal-api",
  "version": "2.0.0",
  "description": "Portfolio risk analytics and derivatives pricing API - Markowitz covariance risk decomposition, parametric VaR, and CRR binomial option pricing over live market data.",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "keywords": [
    "quantitative-finance",
    "portfolio-optimization",
    "markowitz",
    "value-at-risk",
    "options-pricing",
    "binomial-model",
    "black-scholes",
    "express",
    "postgresql"
  ],
  "author": "Mohd Kalam",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.21.0"
  }
}
